# AI Gateway model used by the Import Content Plan and Generate with AI
# features (app/api/import-plan/route.ts). Optional — defaults to a free-tier
# model (inclusionai/ling-3.0-flash-fin) if unset, so the app works with no
# AI Gateway credits purchased.
#
# To use a different model (e.g. after adding paid credits, or to bring your
# own key), set this to any Vercel AI Gateway model slug and redeploy — no
# code change needed. Browse available models, including which ones are free:
# https://vercel.com/ai-gateway/models?freeTier=true
# AI_GATEWAY_MODEL=openai/gpt-5.4-mini

# Or use Claude directly with your own Anthropic API key — this takes
# precedence over AI_GATEWAY_MODEL. ANTHROPIC_MODEL is optional.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Slack DMs for @-mentions and "Notify the team" (app/api/slack-notify).
# Optional — without it, notifications stay in-app only. Bot User OAuth Token
# from the "Content Calendar" Slack app (scopes: chat:write, users:read,
# users:read.email). People are matched to Slack by their login email.
# SLACK_BOT_TOKEN=xoxb-...

# Social tab (Lab → Social posts) model. Defaults to Claude Opus 5.5 for design
# judgement and photo picks; the rest of the app uses ANTHROPIC_MODEL.
# SOCIAL_MODEL=claude-opus-5-5

# Jev (TypeSafe AI) decision model for the AI Lab's fast, structured
# decisions. Optional — without it a small Claude model stands in.
# JEV_API_KEY=...
# JEV_MODEL=jev-latest
